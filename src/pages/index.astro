---
import { Image } from 'astro:assets';
import '../styles/global.css';
import logoMark from '../assets/logo-mark.png';
import logoVcm from '../assets/logo-vcm.png';

const phone = '5511953537478';
const phoneLabel = '(11) 95353-7478';
const email = 'larricarvalho@gmail.com';
const wa = (msg = 'Olá! Gostaria de um orçamento de tratamento fitossanitário.') =>
  `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

const services = [
  {
    title: 'Tratamento Térmico (HT)',
    text: 'Aquecimento controlado de pallets, caixas e embalagens de madeira conforme a norma ISPM 15 / NIMF 15, com marcação IPPC para exportação.',
    icon: 'M12 2c1 3 4 5 4 9a4 4 0 0 1-8 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 0-8Z',
  },
  {
    title: 'Fumigação de Cargas e Contêineres',
    text: 'Fumigação de mercadorias, contêineres e embalagens para eliminar pragas e atender exigências fitossanitárias de importação e exportação.',
    icon: 'M3 7h18v10H3zM7 7v10M11 7v10M15 7v10M19 7v10',
  },
  {
    title: 'Expurgo de Grãos e Armazéns',
    text: 'Expurgo de grãos, sementes e produtos armazenados, protegendo silos, armazéns e estoques contra insetos e perdas.',
    icon: 'M12 21V9m0 0c-3 0-5-2-5-5 3 0 5 2 5 5Zm0 0c3 0 5-2 5-5-3 0-5 2-5 5Zm0 6c-3 0-5-2-5-5 3 0 5 2 5 5Zm0 0c3 0 5-2 5-5-3 0-5 2-5 5Z',
  },
  {
    title: 'Controle de Pragas',
    text: 'Desinsetização, descupinização e controle de pragas urbanas em indústrias, comércios e residências, com produtos registrados e aplicação segura.',
    icon: 'M12 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-4 2h8v6a4 4 0 0 1-8 0v-6ZM4 10l4 2M20 10l-4 2M4 18l4-2M20 18l-4-2',
  },
];

const steps = [
  ['Contato', 'Você nos chama no WhatsApp ou e-mail informando a carga, volume e destino.'],
  ['Avaliação', 'Analisamos o material e a exigência do país de destino e enviamos o orçamento.'],
  ['Tratamento', 'Realizamos o tratamento com equipe técnica, equipamentos aferidos e total segurança.'],
  ['Certificação', 'Entregamos a documentação e a marcação necessárias para liberar sua carga.'],
];

const segments = [
  'Exportadores e importadores',
  'Fabricantes de pallets e embalagens',
  'Indústrias e centros logísticos',
  'Armazéns, cerealistas e cooperativas',
  'Portos, terminais e despachantes',
  'Comércios e residências',
];

const reasons = [
  ['Conformidade', 'Tratamentos alinhados às normas fitossanitárias nacionais e internacionais.'],
  ['Agilidade', 'Atendimento rápido para não travar o embarque da sua carga.'],
  ['Segurança', 'Equipe treinada, EPIs e protocolos rígidos em cada aplicação.'],
  ['Responsabilidade', 'Uso consciente de produtos, respeitando pessoas e meio ambiente.'],
];

const nav = [
  ['Serviços', '#servicos'],
  ['Como funciona', '#como-funciona'],
  ['Segmentos', '#segmentos'],
  ['Contato', '#contato'],
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VCM Tratamento Fitossanitário | Fumigação e Tratamento Térmico ISPM 15</title>
    <meta
      name="description"
      content="VCM Tratamento Fitossanitário: tratamento térmico de embalagens de madeira (ISPM 15), fumigação de cargas e contêineres, expurgo de grãos e controle de pragas. Orçamento pelo WhatsApp."
    />
    <meta property="og:title" content="VCM Tratamento Fitossanitário" />
    <meta property="og:description" content="Controle de pragas com responsabilidade. Tratamento fitossanitário e fumigação para exportação." />
    <meta property="og:image" content={logoMark.src} />
    <meta name="theme-color" content="#0f5a1f" />
    <link rel="icon" href={logoVcm.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-white font-sans text-slate-700 antialiased">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-slate-100 bg-white/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 md:h-20">
        <a href="#" class="flex items-center gap-3" aria-label="VCM Tratamento Fitossanitário">
          <Image src={logoVcm} alt="VCM" width={140} densities={[1, 2]} class="h-9 w-auto md:h-11" />
          <span class="hidden text-xs font-bold leading-tight tracking-wide text-brand-800 uppercase sm:block">
            Tratamento<br />Fitossanitário
          </span>
        </a>
        <nav class="hidden gap-8 text-sm font-semibold text-slate-600 md:flex">
          {nav.map(([label, href]) => <a href={href} class="transition hover:text-brand-700">{label}</a>)}
        </nav>
        <a
          href={wa()}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-brand-700 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-brand-800"
        >
          Orçamento
        </a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden bg-gradient-to-br from-mint via-white to-mint">
        <div class="pointer-events-none absolute -top-32 -right-32 h-[28rem] w-[28rem] rounded-full bg-lime-brand/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-40 -left-20 h-96 w-96 rounded-full bg-brand-600/10 blur-3xl"></div>
        <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:grid-cols-2 md:py-24">
          <div>
            <span class="inline-block rounded-full bg-brand-700/10 px-3 py-1 text-xs font-bold tracking-wide text-brand-700 uppercase">
              Controle de pragas com responsabilidade
            </span>
            <h1 class="mt-5 text-4xl leading-tight font-extrabold text-brand-900 md:text-5xl">
              Tratamento fitossanitário e fumigação para sua carga <span class="text-brand-600">embarcar sem problemas</span>
            </h1>
            <p class="mt-5 max-w-lg text-lg">
              Tratamento térmico de embalagens de madeira (ISPM 15), fumigação de cargas e contêineres, expurgo de grãos e
              controle de pragas, com agilidade e segurança.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href={wa()}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full bg-brand-700 px-6 py-3 font-bold text-white shadow-lg shadow-brand-700/30 transition hover:bg-brand-800"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
                Falar no WhatsApp
              </a>
              <a href="#servicos" class="rounded-full border border-brand-700/30 px-6 py-3 font-semibold text-brand-800 transition hover:bg-brand-700/5">
                Ver serviços
              </a>
            </div>
          </div>
          <Image src={logoMark} alt="Logo VCM Tratamento Fitossanitário" width={560} densities={[1, 2]} class="h-auto w-full drop-shadow-xl" loading="eager" />
        </div>
      </section>

      <!-- Serviços -->
      <section id="servicos" class="scroll-mt-20 py-20">
        <div class="mx-auto max-w-6xl px-4">
          <p class="text-sm font-bold tracking-widest text-brand-600 uppercase">Serviços</p>
          <h2 class="mt-2 max-w-2xl text-3xl font-extrabold text-brand-900 md:text-4xl">Soluções completas em tratamento fitossanitário</h2>
          <div class="mt-12 grid gap-6 sm:grid-cols-2">
            {
              services.map((s) => (
                <article class="group rounded-2xl border border-slate-100 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-lime-brand/40 hover:shadow-lg">
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-mint text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
                  </div>
                  <h3 class="mt-5 text-xl font-bold text-brand-900">{s.title}</h3>
                  <p class="mt-2 leading-relaxed">{s.text}</p>
                  <a href={wa(`Olá! Tenho interesse em: ${s.title}.`)} target="_blank" rel="noopener" class="mt-4 inline-block text-sm font-bold text-brand-700 hover:underline">
                    Solicitar orçamento →
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Como funciona -->
      <section id="como-funciona" class="scroll-mt-20 bg-mint py-20">
        <div class="mx-auto max-w-6xl px-4">
          <p class="text-sm font-bold tracking-widest text-brand-600 uppercase">Como funciona</p>
          <h2 class="mt-2 text-3xl font-extrabold text-brand-900 md:text-4xl">Do contato à carga liberada</h2>
          <ol class="mt-12 grid gap-6 md:grid-cols-4">
            {
              steps.map(([title, text], i) => (
                <li class="relative rounded-2xl bg-white p-6 shadow-sm">
                  <span class="text-5xl font-extrabold text-lime-brand/70">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="mt-2 text-lg font-bold text-brand-900">{title}</h3>
                  <p class="mt-1 text-sm leading-relaxed">{text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Segmentos + Diferenciais -->
      <section id="segmentos" class="scroll-mt-20 py-20">
        <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-2">
          <div>
            <p class="text-sm font-bold tracking-widest text-brand-600 uppercase">Segmentos</p>
            <h2 class="mt-2 text-3xl font-extrabold text-brand-900 md:text-4xl">Para quem atendemos</h2>
            <ul class="mt-8 grid gap-3 sm:grid-cols-2">
              {
                segments.map((s) => (
                  <li class="flex items-start gap-2 rounded-xl border border-slate-100 p-4 font-medium">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
                    {s}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-3xl bg-brand-900 p-8 text-white md:p-10">
            <p class="text-sm font-bold tracking-widest text-lime-brand uppercase">Por que a VCM</p>
            <h2 class="mt-2 text-3xl font-extrabold">Compromisso com cada embarque</h2>
            <dl class="mt-8 space-y-6">
              {
                reasons.map(([title, text]) => (
                  <div class="border-l-4 border-lime-brand pl-4">
                    <dt class="font-bold">{title}</dt>
                    <dd class="mt-1 text-sm text-white/75">{text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </section>

      <!-- Contato -->
      <section id="contato" class="scroll-mt-20 bg-gradient-to-br from-brand-800 to-brand-700 py-20 text-white">
        <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-2">
          <div>
            <h2 class="text-3xl font-extrabold md:text-4xl">Precisa tratar sua carga?</h2>
            <p class="mt-4 max-w-md text-white/80">Conte o que você precisa e retornamos rapidamente com um orçamento.</p>
            <ul class="mt-8 space-y-4 text-lg font-semibold">
              <li><a href={wa()} target="_blank" rel="noopener" class="hover:text-lime-brand">WhatsApp: {phoneLabel}</a></li>
              <li><a href={`mailto:${email}`} class="break-all hover:text-lime-brand">{email}</a></li>
            </ul>
          </div>
          <form id="lead" class="space-y-4 rounded-3xl bg-white p-6 text-slate-700 shadow-2xl md:p-8">
            <label class="block">
              <span class="text-sm font-semibold">Nome</span>
              <input name="nome" required class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 outline-none focus:border-brand-600 focus:ring-2 focus:ring-lime-brand/40" />
            </label>
            <label class="block">
              <span class="text-sm font-semibold">Empresa</span>
              <input name="empresa" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 outline-none focus:border-brand-600 focus:ring-2 focus:ring-lime-brand/40" />
            </label>
            <label class="block">
              <span class="text-sm font-semibold">Serviço</span>
              <select name="servico" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 outline-none focus:border-brand-600 focus:ring-2 focus:ring-lime-brand/40">
                {services.map((s) => <option>{s.title}</option>)}
                <option>Outro</option>
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-semibold">Mensagem</span>
              <textarea name="mensagem" rows="3" placeholder="Tipo de carga, quantidade, destino..." class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 outline-none focus:border-brand-600 focus:ring-2 focus:ring-lime-brand/40"></textarea>
            </label>
            <button class="w-full rounded-full bg-brand-700 py-3 font-bold text-white transition hover:bg-brand-800">Enviar pelo WhatsApp</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="bg-brand-900 py-8 text-sm text-white/70">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 md:flex-row">
        <p>© {new Date().getFullYear()} VCM Tratamento Fitossanitário</p>
        <p>Controle de Pragas com Responsabilidade</p>
      </div>
    </footer>

    <!-- WhatsApp flutuante -->
    <a
      href={wa()}
      target="_blank"
      rel="noopener"
      aria-label="Falar no WhatsApp"
      class="fixed right-5 bottom-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition hover:scale-110"
    >
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
    </a>

    <script define:vars={{ phone }}>
      document.getElementById('lead').addEventListener('submit', (e) => {
        e.preventDefault();
        const f = new FormData(e.target);
        const msg = [
          `Olá! Meu nome é ${f.get('nome')}` + (f.get('empresa') ? ` (${f.get('empresa')})` : '') + '.',
          `Tenho interesse em: ${f.get('servico')}.`,
          f.get('mensagem'),
        ].filter(Boolean).join('\n');
        window.open(`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
      });
    </script>
  </body>
</html>
